[Unit]
Description=Valmiki Ramayana Reader
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/valmiki
Environment=VALMIKI_DATA_DIR=/var/lib/valmiki
Environment=VALMIKI_LOG_LEVEL=INFO
ExecStart=/root/valmiki/.venv/bin/python -m uvicorn valmiki.app:app --host 127.0.0.1 --port 5003 --proxy-headers
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
